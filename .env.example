# ==============================================================================
# CONFIGURATION DES SECRETS — AGENT DE COMMUNICATION CLAUDE CODE
# ==============================================================================
# Copiez ce fichier vers `.env` en local (`cp .env.example .env`) ou déclarez
# ces variables directement dans les paramètres d'environnement de Claude Code Web.
#
# ASTUCE : Tous les outils acceptent le flag `--dry-run` pour être testés
# sans aucune clé API configurée.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BREVO (Optionnel mais recommandé — Newsletters & CRM Contacts)
# ------------------------------------------------------------------------------
# Attention : Si le filtrage d'IP est activé sur votre compte Brevo
# (https://app.brevo.com/security/authorised_ips) et que vous utilisez
# Claude Code Web, autorisez la plage CIDR sortante d'Anthropic : 160.79.104.0/21
BREVO_API_KEY=xkeysib-votre_cle_api_brevo_ici
BREVO_DEFAULT_LIST_ID=2
BREVO_SENDER_NAME=Les Ateliers du Parc
BREVO_SENDER_EMAIL=contact@ateliersduparc.org

# ------------------------------------------------------------------------------
# 2. META GRAPH API (Optionnel — Publication Facebook & Instagram)
# ------------------------------------------------------------------------------
META_PAGE_ID=123456789012345
META_INSTAGRAM_ACCOUNT_ID=17841400000000000
META_PAGE_ACCESS_TOKEN=EAA...votre_jeton_page_longue_duree

# ------------------------------------------------------------------------------
# 3. GOOGLE APPS SCRIPT (Optionnel — E-mails transactionnels & Support)
# ------------------------------------------------------------------------------
APPSCRIPT_WEBHOOK_URL=https://script.google.com/macros/s/VOTRE_ID_DEPLOIEMENT/exec
APPSCRIPT_SECRET_TOKEN=votre_jeton_secret_appscript

# ------------------------------------------------------------------------------
# 4. GOOGLE CLOUD & FIREBASE (Optionnel — Hébergement d'images GCS & Firestore)
# ------------------------------------------------------------------------------
# Vous pouvez fournir le compte de service soit via un fichier local `service_account.json`,
# soit directement en JSON minifié ou Base64 dans `GCP_SERVICE_ACCOUNT_JSON`.
GCP_PROJECT_ID=mon-projet-gcp
GCS_MEDIA_BUCKET=media_ateliers_du_parc
FIREBASE_STORAGE_BUCKET=mon-projet-gcp.firebasestorage.app
GCP_SERVICE_ACCOUNT_JSON=

# Collections Firestore optionnelles (laisser vide pour désactiver la synchro Firestore)
FIRESTORE_CONTACTS_COLLECTION=
FIRESTORE_NEWSLETTERS_COLLECTION=

# ------------------------------------------------------------------------------
# 5. RÉFÉRENT TECHNIQUE (Optionnel — Surcharge de config/organization.json)
# ------------------------------------------------------------------------------
TECH_SUPPORT_NAME=Jérémy Colard
TECH_SUPPORT_EMAIL=support-tech@exemple.org
